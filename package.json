{
  "name": "kestrel",
  "private": true,
  "packageManager": "pnpm@10.7.1",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm --filter @kestrel/admin-ui build",
    "typecheck": "pnpm -r --workspace-concurrency=4 typecheck",
    "modules:check": "node scripts/modules-check.mjs",
    "bundle:check": "node scripts/check-browser-bundles.mjs",
    "db:generate": "pnpm --filter @kestrel/db generate",
    "db:migrate": "pnpm --filter @kestrel/db migrate",
    "create-super-admin": "pnpm --filter @kestrel/auth create-super-admin",
    "dev:app": "pnpm --filter @kestrel/admin-ui dev",
    "dev:docs": "pnpm --filter @kestrel/docs dev",
    "dev:stripe": "pnpm --filter @kestrel/stripe dev",
    "dev:cj": "pnpm --filter @kestrel/cj-dropshipping dev",
    "dev:shippo": "pnpm --filter @kestrel/shippo dev",
    "e2e": "pnpm --filter @kestrel/e2e test",
    "test": "pnpm -r --if-present --filter '!@kestrel/e2e' test",
    "lint": "node --max-old-space-size=8192 node_modules/eslint/bin/eslint.js .",
    "lint:fix": "node --max-old-space-size=8192 node_modules/eslint/bin/eslint.js . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "app:keygen": "node scripts/app-keygen.mjs",
    "bump": "node scripts/bump-version.mjs",
    "demo:seed": "pnpm --filter @kestrel/api demo:seed",
    "demo:products": "pnpm --filter @kestrel/api demo:products",
    "demo:orders": "pnpm --filter @kestrel/api demo:orders",
    "demo:reset": "pnpm --filter @kestrel/api demo:reset"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@eslint/js": "^10.0.1",
    "esbuild": "0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.2"
  }
}
