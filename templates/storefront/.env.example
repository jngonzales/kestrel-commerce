# When started from the repo root (`pnpm dev`), KESTREL_URL is set automatically.
# Use this file to run the storefront on its own (`pnpm dev` in this folder).

KESTREL_URL=http://localhost:3000
# Only when buyers' browsers reach Kestrel at another address than this server does
KESTREL_PUBLIC_URL=
# pk_… from the admin (Settings → publishable keys); optional in single-tenant mode
KESTREL_PUBLISHABLE_KEY=
